# Finapp Backend Configuration

# Supabase or Cloud PostgreSQL Connection String
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# API Security Key
API_KEY=12345

# (Fallback for local PostgreSQL if not using DATABASE_URL)
# DB_USER=postgres
# DB_PASS=1234
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=myfin
